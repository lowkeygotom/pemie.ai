// pemie.ai — modelo de datos multi-tenant.
// Tenencia: Workspace (equipo) -> Project -> {repos, commits, informes, HUs, board, agentes}.
// Todo dato de negocio se scopea por workspaceId/projectId en la capa de servicios.

generator client {
  provider = "prisma-client-js"
  // Las funciones de Vercel corren en Amazon Linux 2023 (OpenSSL 3): sin este
  // target el motor de query no se incluye en el bundle y el API cae en prod.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & tenencia ──────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String? // null si solo entra por OAuth
  name             String?
  avatarUrl        String?
  githubLogin      String?
  // Consentimiento de analítica de producto (PostHog). Un solo booleano no
  // justifica una tabla aparte; ver PLANS/PEMIE_POSTHOG_UX_CONSENT_EVENT_MAP.md.
  analyticsEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  notes       Note[]
  objectives  ObjectiveHistory[]
  contributor Contributor[]
  apiKeys     ApiKey[]            @relation("ApiKeyOwner")
  ownedAgents Agent[]             @relation("AgentOwner")
  channelLinks ChannelLink[]
  channelConfig UserChannelConfig?
  channelLinkTokens ChannelLinkToken[]
  channelMessages ChannelMessage[]
  channelLlmCredentials ChannelLlmCredential[]
  blockedAgentPresences AgentPresence[]     @relation("AgentPresenceBlocker")

  @@map("users")
}

// Proveedores OAuth vinculados (github, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  agentPresences AgentPresence[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("member") // owner | admin | member | viewer
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("member")
  token       String    @unique
  status      String    @default("pending") // pending | accepted | revoked
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invitations")
}

// ─── Proyecto e ingesta ───────────────────────────────────────────────

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String?
  key          String   @default("PRJ") // prefijo para keys de HU: PRJ-123
  storySeq     Int      @default(0) // última key de HU emitida; nunca decrece (PEM-20)
  domainConfig Json? // DomainConfig (packages/shared). null => DEFAULT_DOMAIN_CONFIG
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repos        Repo[]
  contributors Contributor[]
  commits      Commit[]
  objective    Objective?
  objectiveLog ObjectiveHistory[]
  reports      Report[]
  notes        Note[]
  epics        Epic[]
  userStories  UserStory[]
  boards       Board[]
  agents              Agent[]
  apiKeys             ApiKey[]
  channelDefaultsFor  UserChannelConfig[]
  agentPresences      AgentPresence[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("projects")
}

model Repo {
  id             String   @id @default(cuid())
  projectId      String
  provider       String   @default("github")
  owner          String
  name           String
  url            String?
  externalId     String?
  installationId String?
  createdAt      DateTime  @default(now())
  // Última sincronización exitosa: permite la sync incremental al abrir la
  // pestaña sin repetir el histórico completo en cada visita.
  lastSyncedAt   DateTime?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits        Commit[]

  @@unique([projectId, provider, owner, name])
  @@index([projectId])
  @@map("repos")
}

model Contributor {
  id              String      @id @default(cuid())
  projectId       String
  githubLogin     String
  name            String?
  avatarUrl       String?
  userId          String? // vinculado a un User si el contributor es miembro
  createdAt       DateTime    @default(now())
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id])
  commits         Commit[]
  assignedStories UserStory[]
  assignedCards   Card[]

  @@unique([projectId, githubLogin])
  @@index([projectId])
  @@map("contributors")
}

model Commit {
  id            String      @id @default(cuid())
  projectId     String
  repoId        String
  contributorId String
  sha           String
  message       String
  domain        String      @default("otro")
  committedAt   DateTime
  createdAt     DateTime    @default(now())
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo          Repo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([repoId, sha])
  @@index([projectId, committedAt])
  @@index([contributorId])
  @@map("commits")
}

// ─── Objetivo, informes y notas (flujo Hermes generalizado) ───────────

model Objective {
  id          String   @id @default(cuid())
  projectId   String   @unique
  description String
  updatedById String?
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("objectives")
}

model ObjectiveHistory {
  id          String   @id @default(cuid())
  projectId   String
  description String
  updatedById String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@index([projectId, createdAt])
  @@map("objective_history")
}

model Report {
  id        String   @id @default(cuid())
  projectId String
  date      String // YYYY-MM-DD (o "todos" para general)
  slot      String   @default("manual")
  scope     String   @default("day") // day | general
  comment   String?
  verdict   String?
  score     Float?
  metrics   Json?
  agentId   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id])
  notes     Note[]

  @@unique([projectId, date, slot])
  @@index([projectId, createdAt])
  @@map("reports")
}

model Note {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String?
  message     String
  status      String    @default("pending") // pending | processed
  response    String?
  reportId    String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User?     @relation(fields: [authorId], references: [id])
  report      Report?   @relation(fields: [reportId], references: [id])

  @@index([projectId, status, createdAt])
  @@map("notes")
}

// ─── Historias de Usuario ─────────────────────────────────────────────

model Epic {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  description String?
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories     UserStory[]

  @@index([projectId])
  @@map("epics")
}

model UserStory {
  id                 String   @id @default(cuid())
  projectId          String
  key                String // PRJ-123
  title              String
  narrative          Json? // UserStoryNarrative { role, want, benefit }
  acceptanceCriteria Json? // AcceptanceCriterion[]
  priority           String   @default("medium") // low | medium | high | critical
  storyPoints        Int?
  status             String   @default("backlog")
  epicId             String?
  assigneeId         String?
  createdById        String?
  createdByAgentId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic               Epic?        @relation(fields: [epicId], references: [id])
  assignee           Contributor? @relation(fields: [assigneeId], references: [id])
  card               Card?

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("user_stories")
}

// ─── Kanban ───────────────────────────────────────────────────────────

model Board {
  id        String   @id @default(cuid())
  projectId String
  name      String   @default("Board")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   Column[]
  cards     Card[]

  @@index([projectId])
  @@map("boards")
}

model Column {
  id       String @id @default(cuid())
  boardId  String
  name     String
  order    Int
  wipLimit Int?
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
  @@map("columns")
}

model Card {
  id          String         @id @default(cuid())
  boardId     String
  columnId    String
  order       Float
  type        String         @default("task") // story | task | bug
  title       String
  description String?
  userStoryId String?        @unique
  assigneeId  String?
  labels      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  userStory   UserStory?     @relation(fields: [userStoryId], references: [id])
  assignee    Contributor?   @relation(fields: [assigneeId], references: [id])
  activities  CardActivity[]

  @@index([boardId, columnId])
  @@index([assigneeId])
  @@map("cards")
}

model CardActivity {
  id        String   @id @default(cuid())
  cardId    String
  actorType String // user | agent
  actorId   String?
  action    String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@map("card_activities")
}

// ─── Agentes, API keys y trazabilidad ─────────────────────────────────

model Agent {
  id        String   @id @default(cuid())
  projectId String
  name      String
  kind      String   @default("mcp")
  /// Persona que creó el agente. Null en los agentes anteriores a PEM-35: no
  /// hay de dónde deducirlo, createAgent no auditaba. No indica pertenencia
  /// al equipo — el dueño puede seguir existiendo sin membresía.
  ownerId   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?    @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  apiKeys   ApiKey[]
  reports   Report[]

  @@index([projectId])
  @@map("agents")
}

model ApiKey {
  id           String    @id @default(cuid())
  workspaceId  String
  projectId    String?
  agentId      String?
  /// project | workspace | user — alcance MCP. Default project (compat).
  scopeLevel   String    @default("project")
  /// Dueño de una user key (obligatorio si scopeLevel = user).
  ownerUserId  String?
  name         String
  hashedKey    String    @unique
  prefix       String // primeros chars visibles para identificar la key
  scopes       String[] // ApiScope[]
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        Agent?    @relation(fields: [agentId], references: [id])
  owner        User?     @relation("ApiKeyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  channelConfig UserChannelConfig?
  presences    AgentPresence[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([ownerUserId])
  @@map("api_keys")
}

/// Rastro de que una API key operó en un workspace. Existe porque las keys
/// workspace/user no tienen fila `Agent` en ninguna parte: sin esto, un agente
/// que trabaja en tu equipo con una key ajena es invisible en el roster.
/// La fila la crea el propio uso (control de admisión), nunca un alta manual.
model AgentPresence {
  id            String    @id @default(cuid())
  apiKeyId      String
  workspaceId   String
  /// Último proyecto en el que se la vio; solo informativo para el roster.
  lastProjectId String?
  /// Bloqueo decidido por un admin del workspace *anfitrión*, no del dueño de
  /// la key: por eso vive aquí y no en ApiKey.
  blockedAt     DateTime?
  blockedById   String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastProject   Project?  @relation(fields: [lastProjectId], references: [id], onDelete: SetNull)
  blockedBy     User?     @relation("AgentPresenceBlocker", fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([apiKeyId, workspaceId])
  @@index([workspaceId])
  @@map("agent_presences")
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorType   String // user | agent
  actorId     String?
  action      String
  entity      String?
  entityId    String?
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// ─── Canales (Telegram) ───────────────────────────────────────────────

/// Vínculo permanente usuario Pemie ↔ cuenta Telegram.
model ChannelLink {
  id         String   @id @default(cuid())
  userId     String
  provider   String   @default("telegram") // telegram
  externalId String // telegram user id
  username   String?
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("channel_links")
}

/// Config del canal del usuario: MCP user-key + proveedor/modelo activos + resumen rolling.
model UserChannelConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  apiKeyId             String   @unique
  llmProvider          String   @default("anthropic")
  /// Espejo del credential activo (compat); fuente de verdad: ChannelLlmCredential.
  llmKeyCiphertext     String? // AES-GCM; null = falta configurar el proveedor activo
  llmKeyLast4          String?
  model                String   @default("claude-sonnet-5")
  /// Resumen compacto del hilo fuera de la ventana de mensajes.
  conversationSummary  String?
  defaultProjectId     String?
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey               ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  defaultProject       Project? @relation(fields: [defaultProjectId], references: [id], onDelete: SetNull)

  @@map("user_channel_configs")
}

/// BYOK por proveedor (permite /proveedor en Telegram sin re-pegar la key).
model ChannelLlmCredential {
  id               String   @id @default(cuid())
  userId           String
  provider         String // anthropic | openai | deepseek
  llmKeyCiphertext String
  llmKeyLast4      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("channel_llm_credentials")
}

/// Historial corto del chat Telegram (cola deslizante; no guarda tool calls).
model ChannelMessage {
  id        String   @id @default(cuid())
  userId    String
  // `createdAt` es el timestamp de transacción: el par user+assistant de un turno
  // se inserta junto y comparte valor, así que no ordena dentro del par. `seq` da
  // el orden monotónico que la API de chat exige (user antes que assistant).
  seq       Int      @default(autoincrement())
  provider  String   @default("telegram")
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, seq])
  @@map("channel_messages")
}

/// Token one-shot para t.me/Bot?start=<token>.
model ChannelLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  projectId String? // proyecto desde el que se abrió el deep link (home opcional)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("channel_link_tokens")
}

/// Update entrante ya visto. La unique (provider, updateId) hace de candado de
/// idempotencia frente a los reintentos del webhook, y las filas recientes por
/// externalId son el rate limit (en serverless no sirve un contador en memoria).
model ChannelUpdate {
  id          String    @id @default(cuid())
  provider    String    @default("telegram")
  updateId    String // update_id de Telegram
  externalId  String // telegram user id
  processedAt DateTime? // null = reservado pero no terminado (turno caído)
  createdAt   DateTime  @default(now())

  @@unique([provider, updateId])
  @@index([provider, externalId, createdAt])
  @@index([createdAt])
  @@map("channel_updates")
}
