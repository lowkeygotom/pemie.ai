# ─── Backend (apps/api) ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Postgres (docker compose provee uno local en localhost:5433)
DATABASE_URL=postgresql://pemie:pemie@localhost:5433/pemie?schema=public

# Sesiones / JWT
SESSION_SECRET=change-me-in-prod-please-32-chars-min

# Origen del frontend. En local es Vite; en el deploy de Vercel (front + API en
# el mismo dominio) NO hace falta setearlo: se resuelve del dominio del deploy y
# los redirects de OAuth usan el origen de la petición, así los previews también
# funcionan. Setéalo solo si el front vive en otro dominio que el API.
WEB_ORIGIN=http://localhost:5173
# Orígenes extra con permiso de CORS (coma-separados). Opcional.
WEB_ORIGINS=
# Origen público del API. Solo si hay un proxy que no reenvía x-forwarded-host.
PUBLIC_API_URL=

# GitHub OAuth (login). El callback a registrar en la OAuth App es
#   local → http://localhost:4000/api/auth/github/callback
#   prod  → https://<tu-dominio>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App (conexión de repos + webhooks). Webhook URL: https://<dominio>/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Claude API (generación server-side de HUs / informes)
ANTHROPIC_API_KEY=

# Deepgram (modo mesa): key server-side para emitir JWTs de escucha efímeros.
DEEPGRAM_API_KEY=

# Vercel Blob privado: token de escritura para emitir uploads directos del audio.

# Telegram bot (canal on-demand). Crear bot en @BotFather.
# Webhook URL: https://<dominio>/webhooks/telegram
# Header secreto: X-Telegram-Bot-Api-Secret-Token = TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Cifrado de Anthropic BYOK del usuario (AES-256-GCM). Generar:
#   openssl rand -base64 32
CHANNEL_SECRETS_KEY=

# Correo. Resend es el transporte definitivo. Sin key, SMTP permite una prueba
# temporal de entrega real; deja estas variables vacías para usar Ethereal en
# dev. En producción, sin Resend ni SMTP, no se envía correo y queda el link.
RESEND_API_KEY=
MAIL_FROM=pemie.ai <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Analítica de producto (PostHog, PEM-8) — server-side, solo eventos telegram_*.
# Sin key, el wrapper de services/analytics.ts es un no-op silencioso.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── Frontend (apps/web) ───────────────────────────────────────────────
# Solo para dev: en producción el front llama al API en su mismo origen (/api),
# así que déjala vacía o sin definir en Vercel. Si la seteas a un dominio
# distinto, la cookie de sesión pasa a ser de terceros y los navegadores la
# bloquean.
VITE_API_URL=http://localhost:4000

# Analítica de producto (PostHog, PEM-8) — cliente. Sin key, la app funciona
# igual pero sin analítica (apps/web/src/lib/analytics no inicializa el SDK).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
