{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm run db:generate --workspace @pemie/api",
  "buildCommand": "npm run db:deploy --workspace @pemie/api && npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/api(/.*)?", "dest": "/api/server" },
    { "src": "/mcp", "dest": "/api/server" },
    { "src": "/webhooks(/.*)?", "dest": "/api/server" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
